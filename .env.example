# The app reads local/.env, not this file. Run `sh scripts/aidtrace configure` to create it,
# then fill in the values below.

# Always needed. configure fills APP_ORIGIN, the passwords, PAYPAL_BASE_URL and MAX_DEMO_PAYOUT_CENTS.
APP_ORIGIN=
SEED_PASSWORD_MARIA=
SEED_PASSWORD_TARA=
SEED_PASSWORD_BEN=
PAYPAL_SANDBOX_PAYEE_EMAIL=
PAYEE_ALLOWLIST=

# PayPal sandbox payouts and donations
PAYPAL_BASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MAX_DEMO_PAYOUT_CENTS=
PAYPAL_BALANCE_READABLE=false

# Webhooks, optional: Refresh status settles a payout without them
PAYPAL_PRODUCT_WEBHOOK_ENABLED=false
PAYPAL_PRODUCT_WEBHOOK_ID=

# AI features, optional. Leave AIDTRACE_RECEIPT_AI_PROVIDER and AIDTRACE_CLAUDE_MODEL out:
# a blank value turns the AI off on purpose.
ANTHROPIC_API_KEY=
AI_RECEIPT_ENABLED=false
AI_RECEIPT_PHOTO_ENABLED=false
AI_EXPENSE_PROPOSALS_ENABLED=false
AI_RULE_DRAFTS_ENABLED=false
AI_COMPLIANCE_ENABLED=false
AI_ANALYTICS_ENABLED=false

# Fund modes and Autopilot, optional
FUND_MODES_ENABLED=false
FUND_AUTOPILOT_ENABLED=false

# Worker intervals in milliseconds, optional (default 300000, minimum 60000)
# DONATION_SWEEP_INTERVAL_MS=300000
# POLICY_SWEEP_INTERVAL_MS=300000
