#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
export AIDTRACE_COMPOSE_PROJECT=${AIDTRACE_COMPOSE_PROJECT:-aidtrace-judge}
export AIDTRACE_AI_PROJECT=${AIDTRACE_AI_PROJECT:-aidtrace-judge-ai}
export AIDTRACE_AI_EVIDENCE="$root/local/ai-check"
compose() { docker --context orbstack compose -p "$AIDTRACE_COMPOSE_PROJECT" "$@"; }
ai() { docker --context orbstack compose -p "$AIDTRACE_AI_PROJECT" -f compose.ai-check.yaml "$@"; }
review() { docker --context orbstack compose -p "$AIDTRACE_COMPOSE_PROJECT" -f compose.yaml -f compose.receipt-ai.yaml -f compose.review.yaml "$@"; }
case "${1:-}" in
  setup)
    compose build app
    compose run --rm --no-deps app pnpm install --frozen-lockfile
    compose run --rm --no-deps app pnpm rebuild esbuild
    ;;
  configure) compose run --rm --no-deps app node scripts/init-local.mjs ;;
  pnpm) shift; compose run --rm app pnpm "$@" ;;
  up) compose up -d --wait ;;
  review-up)
    review up -d --wait db
    review stop app
    review run --rm --no-deps app pnpm build
    review up -d --wait --no-deps --force-recreate app
    ;;
  down) compose stop; ai stop ;;
  status) compose ps; ai ps ;;
  logs) compose logs --tail 60 app ;;
  check) compose run --rm app pnpm test; compose run --rm --no-deps app pnpm typecheck ;;
  build)
    if [ -n "$(compose ps -q --status running app)" ]; then echo 'Stop the judge app before building.' >&2; exit 2; fi
    compose run --rm --no-deps app pnpm build
    ;;
  receipt-ai-up)
    (umask 077; mkdir -p local/ai-check)
    ai run --rm --no-deps download
    ai up -d model
    docker --context orbstack compose -p "$AIDTRACE_COMPOSE_PROJECT" -f compose.yaml -f compose.receipt-ai.yaml up -d --wait app
    ;;
  receipt-ai-down) ai stop; compose up -d --wait --force-recreate app ;;
  ai-check)
    shift
    case "${1:-}" in
      download) ai run --rm --no-deps download ;;
      evaluate) (umask 077; mkdir -p local/ai-check); ai up -d model; ai run --rm --no-deps evaluate ;;
      down) ai stop ;;
      *) echo 'Use ai-check download|evaluate|down' >&2; exit 2 ;;
    esac
    ;;
  ui-check)
    compose up -d --wait db
    ui_source=$(mktemp -d "$root/local/ui-source-XXXXXX")
    compose run --rm --no-deps app node scripts/snapshot-judge.mjs "${ui_source#"$root/"}"
    export AIDTRACE_UI_SOURCE="$ui_source"
    docker --context orbstack compose -p "$AIDTRACE_COMPOSE_PROJECT" -f compose.yaml -f compose.ui.yaml build ui
    docker --context orbstack compose -p "$AIDTRACE_COMPOSE_PROJECT" -f compose.yaml -f compose.ui.yaml run --rm --no-deps --use-aliases ui
    ;;
  *) echo 'Use setup|configure|pnpm|up|review-up|down|status|logs|check|build|receipt-ai-up|receipt-ai-down|ai-check|ui-check' >&2; exit 2 ;;
esac
